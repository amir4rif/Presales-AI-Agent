# Active data layer. Keep "seed" until the final implementation session.
DATA_SOURCE=seed

# Anthropic (server-only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_DEFAULT_MAX_TOKENS=4096
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_TIMEOUT_MS=90000

# Lark custom app + Base (server-only)
LARK_APP_ID=
LARK_APP_SECRET=
LARK_APP_TOKEN=
LARK_TABLE_ID=

# Optional. Leave blank to discover the table's primary field automatically.
LARK_PRIMARY_FIELD=
LARK_BASE_URL=https://open.larksuite.com
LARK_TIMEOUT_MS=15000
