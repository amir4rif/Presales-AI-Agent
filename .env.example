# Active data layer. Use seed for the offline fallback or supabase for shared data.
DATA_SOURCE=seed

# Supabase Auth + Database. The publishable key is intentionally public; RLS
# is the authorization boundary. Never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI provider (server-only key). Gemini is the free-tier default.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Visible-answer budget. Gemini's thinking tokens are added on top of this by
# ai-provider.ts, not carved out of it, so this is the actual room the answer gets.
GEMINI_DEFAULT_MAX_TOKENS=4096
GEMINI_MAX_TOKENS=16000
GEMINI_TIMEOUT_MS=90000

# Optional fallback provider. Set AI_PROVIDER=anthropic to use it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_DEFAULT_MAX_TOKENS=4096
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_TIMEOUT_MS=90000

# Optional prospect research. Kept server-side behind /api/research.
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_MS=30000

# Dormant Lark bridge retained for a future company-credential switch.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_APP_TOKEN=
LARK_TABLE_ID=

# Optional. Leave blank to discover the table's primary field automatically.
LARK_PRIMARY_FIELD=
LARK_BASE_URL=https://open.larksuite.com
LARK_TIMEOUT_MS=15000
